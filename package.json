{
  "name": "voice-recorder",
  "version": "1.0.0",
  "description": "Voice Recorder - record, save, and manage voice notes. Runs as a web page, a desktop app (Electron), or a mobile app (Capacitor).",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "npx --yes http-server web -p 8080 -c-1",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "@capacitor/cli": "^6.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  }
}
